<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ArcadiusOffline</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildThisFileDirectory)../../Arcadius_Data/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GameManaged)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.Runtime"><HintPath>$(GameManaged)/FishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Services.CloudCode"><HintPath>$(GameManaged)/Unity.Services.CloudCode.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
